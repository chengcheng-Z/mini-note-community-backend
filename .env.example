# 复制为 .env 后再修改；.env 不要提交到 Git
TAG=latest
# 本地构建用 xiaohashu；生产用 ACR 公网地址/命名空间，以控制台“访问凭证”页面为准
# 个人版示例：crpi-xxxx.cn-beijing.personal.cr.aliyuncs.com/你的命名空间
APP_IMAGE_PREFIX=xiaohashu
TZ=Asia/Shanghai

# 单机部署保持 127.0.0.1；多机部署改成 0.0.0.0，并只放通内网
INFRA_BIND_IP=127.0.0.1

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=xiaohashu
MYSQL_USERNAME=root
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Redis
REDIS_PASSWORD=change-me
REDIS_HOST=redis
REDIS_PORT=6379

# Cassandra
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
# 多机部署时填基础设施机器的内网 IP，单机留空
CASSANDRA_BROADCAST_ADDRESS=
CASSANDRA_BROADCAST_RPC_ADDRESS=

# RocketMQ
ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876
# 多机部署时填基础设施机器的内网 IP，单机留空
BROKER_IP=

# Nacos
NACOS_SERVER_ADDR=nacos:8848
NACOS_NAMESPACE=public
# 多机部署时填当前应用服务器的内网 IP；单机留空
DISCOVERY_IP=

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
# OSS 容器访问 MinIO 的地址
MINIO_ENDPOINT=http://minio:9000
# 浏览器/客户端访问 MinIO 的地址，多机时改成公网或内网可访问地址
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# 存储类型：minio 或 aliyun
STORAGE_TYPE=minio

# 阿里云 OSS（STORAGE_TYPE=aliyun 时使用）
# 用 MinIO 时保留占位值，避免未使用的阿里云客户端初始化失败
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY=disabled
ALIYUN_OSS_SECRET_KEY=disabled

# 阿里云短信（auth 登录/发验证码时使用）
# 没有真实 AK 时保留占位值，服务能启动，但发短信会失败
ALIYUN_ACCESS_KEY_ID=disabled
ALIYUN_ACCESS_KEY_SECRET=disabled

# 各服务对外端口
GATEWAY_PORT=8000
AUTH_PORT=8080
OSS_PORT=8081
USER_PORT=8082
KV_PORT=8084
DISTRIBUTED_ID_PORT=8085
NOTE_PORT=8086
USER_RELATION_PORT=8087
COUNT_PORT=8090
